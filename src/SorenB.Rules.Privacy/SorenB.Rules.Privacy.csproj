<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Brand values come from Directory.Build.props. -->
    <PackageId>$(BrandPackageId)</PackageId>
    <RootNamespace>SorenB.Rules.Privacy</RootNamespace>
    <AssemblyName>SorenB.Rules.Privacy</AssemblyName>
    <Title>$(BrandTitle)</Title>
    <Description>$(BrandDescription)</Description>
    <PackageTags>UiPath;RPA;Workflow Analyzer;GDPR;Privacy;Compliance;Security</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(BrandIconPath)" Pack="true" PackagePath="icon.png" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read by RuleMessage.DocumentationLink. -->
    <AssemblyMetadata Include="DocsUrlFormat" Value="$(BrandDocsUrlFormat)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Studio supplies the API at runtime; keep it out of the package's dependencies. -->
    <PackageReference Include="UiPath.Activities.Api" Version="23.10.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SorenB.Rules.Privacy.Tests" />
  </ItemGroup>

</Project>
